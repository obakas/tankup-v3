generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  CREATED
  ASSIGNED
  LOADING
  EN_ROUTE
  ARRIVED
  MEASURING
  AWAITING_OTP
  COMPLETED
  FAILED
  SKIPPED
}

enum ActorType {
  CUSTOMER
  DRIVER
  FLEET_HEAD
  ADMIN
  SYSTEM
}

enum OperationalAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
}

enum NotificationCategory {
  TRANSACTIONAL
  OPERATIONAL
  ALERT
  ESCALATION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
}

model Delivery {
  id                        String         @id @default(uuid())
  status                    DeliveryStatus @default(CREATED)
  customerId                String?
  driverId                  String?
  tankerId                  String?
  siteId                    String?
  otpCode                   String?
  otpExpiresAt              DateTime?
  otpVerifiedAt             DateTime?
  otpVerifiedByActorType    ActorType?
  otpVerifiedByActorId      String?
  otpAttemptCount           Int            @default(0)

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  events                    DeliveryEvent[]
  auditLogs                 AuditLog[]
  alerts                    DeliveryAlert[]
  notifications             Notification[]
}

model DeliveryEvent {
  id          String   @id @default(uuid())
  deliveryId  String
  type        String
  actorType   ActorType
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id])
  notifications Notification[]
}

model AuditLog {
  id          String   @id @default(uuid())
  actorType   ActorType
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id])
}

model DeliveryAlert {
  id          String                   @id @default(uuid())
  deliveryId  String
  type        String
  severity    OperationalAlertSeverity
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  delivery    Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, type, resolvedAt])
}

model Notification {
  id                 String               @id @default(uuid())
  recipientActorType ActorType
  recipientActorId   String?
  recipientKey       String
  channel            NotificationChannel  @default(IN_APP)
  category           NotificationCategory
  priority           NotificationPriority @default(NORMAL)
  title              String
  message            String
  relatedEntityType  String
  relatedEntityId    String
  status             NotificationStatus   @default(UNREAD)
  metadata           Json?
  readAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  deliveryId         String?
  delivery           Delivery?            @relation(fields: [deliveryId], references: [id])
  sourceEventId      String
  sourceEvent        DeliveryEvent        @relation(fields: [sourceEventId], references: [id])

  @@unique([sourceEventId, recipientKey])
  @@index([recipientKey, status, createdAt])
}
