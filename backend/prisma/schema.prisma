generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  CREATED
  ASSIGNED
  LOADING
  EN_ROUTE
  ARRIVED
  MEASURING
  AWAITING_OTP
  COMPLETED
  FAILED
  SKIPPED
}

enum ActorType {
  CUSTOMER
  DRIVER
  FLEET_HEAD
  ADMIN
  SYSTEM
}

enum OperationalAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationChannel {
  IN_APP
}

enum NotificationCategory {
  TRANSACTIONAL
  OPERATIONAL
  ALERT
  ESCALATION
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
}

enum TankerAvailabilityStatus {
  AVAILABLE
  ASSIGNED
  UNAVAILABLE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum AssignmentDecisionResult {
  ACCEPTED
  REJECTED
  EXPIRED
}

model Delivery {
  id                        String         @id @default(uuid())
  status                    DeliveryStatus @default(CREATED)
  customerId                String?
  driverId                  String?
  tankerId                  String?
  siteId                    String?
  otpCode                   String?
  otpExpiresAt              DateTime?
  otpVerifiedAt             DateTime?
  otpVerifiedByActorType    ActorType?
  otpVerifiedByActorId      String?
  otpAttemptCount           Int            @default(0)

  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  events                    DeliveryEvent[]
  auditLogs                 AuditLog[]
  alerts                    DeliveryAlert[]
  notifications             Notification[]
  jobOffers                 JobOffer[]
  assignmentDecisions       AssignmentDecision[]
}

model Tanker {
  id                 String                   @id @default(uuid())
  label              String?
  driverId           String?
  fleetId            String?
  capacityLiters     Int?
  availabilityStatus TankerAvailabilityStatus @default(AVAILABLE)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  jobOffers          JobOffer[]
  assignmentDecisions AssignmentDecision[]

  @@index([availabilityStatus])
}

model JobOffer {
  id           String      @id @default(uuid())
  deliveryId   String
  tankerId     String
  status       OfferStatus @default(PENDING)
  score        Int         @default(0)
  reason       String?
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  delivery     Delivery    @relation(fields: [deliveryId], references: [id])
  tanker       Tanker      @relation(fields: [tankerId], references: [id])
  decisions    AssignmentDecision[]

  @@index([deliveryId, status])
  @@index([tankerId, status])
  @@index([expiresAt])
}

model AssignmentDecision {
  id          String                   @id @default(uuid())
  jobOfferId  String
  deliveryId  String
  tankerId    String
  result      AssignmentDecisionResult
  actorType   ActorType
  actorId     String?
  reason      String?
  createdAt   DateTime                 @default(now())

  jobOffer    JobOffer                 @relation(fields: [jobOfferId], references: [id])
  delivery    Delivery                 @relation(fields: [deliveryId], references: [id])
  tanker      Tanker                   @relation(fields: [tankerId], references: [id])

  @@index([deliveryId, createdAt])
  @@index([tankerId, createdAt])
}

model DeliveryEvent {
  id          String   @id @default(uuid())
  deliveryId  String
  type        String
  actorType   ActorType
  actorId     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  delivery    Delivery @relation(fields: [deliveryId], references: [id])
  notifications Notification[]
}

model AuditLog {
  id          String   @id @default(uuid())
  actorType   ActorType
  actorId     String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  deliveryId  String?
  delivery    Delivery? @relation(fields: [deliveryId], references: [id])
}

model DeliveryAlert {
  id          String                   @id @default(uuid())
  deliveryId  String
  type        String
  severity    OperationalAlertSeverity
  metadata    Json?
  resolvedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  delivery    Delivery @relation(fields: [deliveryId], references: [id])

  @@index([deliveryId, type, resolvedAt])
}

model Notification {
  id                 String               @id @default(uuid())
  recipientActorType ActorType
  recipientActorId   String?
  recipientKey       String
  channel            NotificationChannel  @default(IN_APP)
  category           NotificationCategory
  priority           NotificationPriority @default(NORMAL)
  title              String
  message            String
  relatedEntityType  String
  relatedEntityId    String
  status             NotificationStatus   @default(UNREAD)
  metadata           Json?
  readAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  deliveryId         String?
  delivery           Delivery?            @relation(fields: [deliveryId], references: [id])
  sourceEventId      String
  sourceEvent        DeliveryEvent        @relation(fields: [sourceEventId], references: [id])

  @@unique([sourceEventId, recipientKey])
  @@index([recipientKey, status, createdAt])
}
